# Use ledgr_app (restricted role) once migration 007 has run.
# ledgr_app has SELECT+INSERT on all tables but no UPDATE/DELETE on events.
DATABASE_URL=postgresql+asyncpg://ledgr_app:ledgr_app@localhost:5432/ledgr

# Railway injects DATABASE_URL automatically when a Postgres plugin is attached.
# On Railway: DATABASE_URL=postgresql+asyncpg://$PGUSER:$PGPASSWORD@$PGHOST:$PGPORT/$PGDATABASE

REDIS_URL=redis://localhost:6379
# On Railway with Upstash: REDIS_URL=$UPSTASH_REDIS_REST_URL (or the direct Redis URL)

JWT_SECRET=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated allowed CORS origins (add Vercel URL for production)
CORS_ORIGINS=http://localhost:3000
